# Holy Cross peer-comparison project - .gitignore

# Secrets - NEVER commit these
.Renviron
.env
*.key
*_api_key.txt

# R session / build artifacts
.Rhistory
.Rapp.history
.RData
.Rproj.user/
*.Rproj.user/
.Ruserdata

# OS junk
.DS_Store
Thumbs.db
*~$*

# IDE
.vscode/
.idea/

# Generated outputs - regenerated by running the pipelines
output/
*.csv

# Re-allow the Carnegie file
!data/2025-Public-Data-File.xlsx

# Re-allow the curated CSVs the Shiny app reads at startup (schools.csv,
# the five {module}_facts.csv / {module}_variables.csv pairs, and
# value_labels.csv). The clustvarsel .rds / .log research artifacts and
# the local plotly preview directory stay ignored.
!output/
!output/*.csv
output/*.rds
output/*.log
output/previews/

# Re-allow the curated CSVs the Shiny apps read from data/. These are
# hand-edited reference files (not pipeline outputs), so they belong in
# version control.
!data/variables_descriptions.csv
!data/neche_cohort.csv
!data/stratum_descriptions.csv
!data/ajcu_members.csv
!data/eada_conferences.csv
!data/eada_conferences_unmatched.csv
!data/forbes_top_colleges_*.csv

# Re-allow the bundled CSVs the Shiny app loads at startup: the NECHE
# cohort and the stratum-description lookup.
!shiny_app/data/*.csv

# IPEDS source files that aren't the .Rda we ship
data/*.accdb
data/*.zip
data/*Tablesdoc.xlsx
data/*TablesDoc.xlsx
data/ReadMe*.docx

# Python build artifacts
__pycache__/
*.pyc
*.pyo

# Scraper audit snapshots (regenerated on each run)
data/forbes_page_*.html
scratchpad/
